{
    "name": "portfolio",
    "version": "1.3.3",
    "scripts": {
        "ng": "ng",
        "start:dev": "node ./set-env.dev.ts && ng serve --open",
        "start:stag": "node set-env.ts && ng serve --configuration staging",
        "start:prod": "node set-env.ts && ng serve --configuration production",
        "build": "ng build && npx serve dist/portfolio/browser",
        "build:stag": "node set-env.ts && ng build --configuration staging",
        "build:prod": "node set-env.ts && ng build --configuration production",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint"
    },
    "private": true,
    "packageManager": "npm@10.9.0",
    "dependencies": {
        "@angular/common": "^22.0.0",
        "@angular/compiler": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/platform-browser": "^22.0.0",
        "@angular/router": "^22.0.0",
        "axios": "^1.14.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "underscore": "^1.13.8"
    },
    "devDependencies": {
        "@angular/build": "^22.0.0",
        "@angular/cli": "^22.0.0",
        "@angular/compiler-cli": "^22.0.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.5.0",
        "@types/underscore": "^1.13.0",
        "angular-eslint": "^22.0.0",
        "dotenv": "^17.3.1",
        "eslint": "^10.0.3",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.1",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.56.1",
        "vitest": "^4.0.8"
    },
    "overrides": {
        "vite": "^7.3.5",
        "@babel/core": "7.29.7",
        "piscina": "5.2.0",
        "esbuild": "0.28.1"
    }
}
